# Nexus — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ─── Tenant ───────────────────────────────────────────────
# Default tenant for local development. In production, each
# tenant has its own entry in tenants/<tenant_id>.json
NEXUS_DEFAULT_TENANT_ID=dev-tenant-001

# ─── LLM Provider ─────────────────────────────────────────
# Provider: "gemini" | "openai" | "anthropic"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
GOOGLE_API_KEY=your_google_api_key_here

# If switching to OpenAI:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# OPENAI_API_KEY=your_openai_api_key_here

# If switching to Anthropic:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── CRM Backend ──────────────────────────────────────────
# Backend: "sqlite" | "zoho" | "hubspot" | "salesforce"
CRM_BACKEND=sqlite
SQLITE_DB_PATH=./data/nexus.db

# If using Zoho (free tier, no credit card required):
# CRM_BACKEND=zoho
# ZOHO_CLIENT_ID=your_zoho_client_id
# ZOHO_CLIENT_SECRET=your_zoho_client_secret
# ZOHO_REFRESH_TOKEN=your_zoho_refresh_token

# ─── Research MCP Server ──────────────────────────────────
# Jina Reader — free, no key required for basic use
JINA_API_KEY=

# DuckDuckGo search — no key required (used by default)
# Optional upgrade: swap to SerpAPI for higher volume / structured results
# SERPAPI_KEY=your_serpapi_key_here

# ─── Enrichment (optional) ────────────────────────────────
# Hunter.io — 25 free email verifications/month
HUNTER_API_KEY=your_hunter_api_key_here

# Apollo.io — 50 free export credits/month
APOLLO_API_KEY=your_apollo_api_key_here

# ─── Integration Webhook Receiver ─────────────────────────
# Secret used to validate inbound webhook signatures.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=your_webhook_secret_here
WEBHOOK_PORT=8080

# ─── Governance ───────────────────────────────────────────
# Minimum Scorer confidence required for an unattended CRM write.
# Writes below this threshold go to pending_approval.
MIN_WRITE_CONFIDENCE=0.6

# Maximum Researcher retries before escalating to human.
MAX_AGENT_RETRIES=2
